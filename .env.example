# Required
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
MAX_UPLOAD_MB=500

# Local storage is used when S3_BUCKET is blank.
# For AWS S3, set bucket, region and a public/CloudFront URL for HLS playback.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=

# Optional custom executable path
FFMPEG_PATH=ffmpeg

# Optional storage/database overrides
# DATA_DIR=./data
# DATABASE_PATH=./data/app.db
